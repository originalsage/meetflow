<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lls.mapper.MeetingRoomMapper">

    <resultMap id="BaseResultMap" type="com.lls.entity.MeetingRoom">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="room_number" property="roomNumber"/>
        <result column="capacity" property="capacity"/>
        <result column="area" property="area"/>
        <result column="purpose" property="purpose"/>
        <result column="photo_url" property="photoUrl"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, room_number, capacity, area, purpose, photo_url, status, create_time, update_time
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM meeting_room
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM meeting_room
        WHERE id = #{id}
    </select>

    <select id="selectByRoomNumber" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM meeting_room
        WHERE room_number = #{roomNumber}
    </select>

    <select id="selectAvailable" parameterType="com.lls.dto.ReservationQueryDTO" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM meeting_room
        WHERE status = 1
        <if test="attendeeCount != null">
            AND capacity >= #{attendeeCount}
        </if>
        <if test="date != null and startTime != null and endTime != null">
            AND id NOT IN (
                SELECT DISTINCT meeting_room_id
                FROM reservation
                WHERE reservation_date = #{date}
                AND status IN (0, 1)
                AND (
                    (start_time &lt; #{endTime} AND end_time > #{startTime})
                )
            )
        </if>
        ORDER BY capacity ASC
    </select>

    <insert id="insert" parameterType="com.lls.entity.MeetingRoom" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO meeting_room (name, room_number, capacity, area, purpose, photo_url, status)
        VALUES (#{name}, #{roomNumber}, #{capacity}, #{area}, #{purpose}, #{photoUrl}, #{status})
    </insert>

    <update id="update" parameterType="com.lls.entity.MeetingRoom">
        UPDATE meeting_room
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="roomNumber != null and roomNumber != ''">room_number = #{roomNumber},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="area != null">area = #{area},</if>
            <if test="purpose != null">purpose = #{purpose},</if>
            <if test="photoUrl != null">photo_url = #{photoUrl},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM meeting_room WHERE id = #{id}
    </delete>

</mapper>

